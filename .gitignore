
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# The catalogue a local Spark session writes managed tables into
spark-warehouse/

# Rendered reports, rebuilt from their .qmd with quarto render
docs/notebooks/*.html
docs/notebooks/_cache/
# and what rendering a template beside it leaves: the PDF, the Typst
# source, and Quarto's cache of the fonts it found
src/fincommons/**/templates/*.pdf
src/fincommons/**/templates/*.typ
.quarto/

# The command history R writes into its working directory
.Rhistory

# LaTeX build products of the handbook; the PDF is built, not committed
docs/handbook/*.aux
docs/handbook/*.bbl
docs/handbook/*.bcf
docs/handbook/*.blg
docs/handbook/*.fdb_latexmk
docs/handbook/*.fls
docs/handbook/*.log
docs/handbook/*.out
docs/handbook/*.run.xml
docs/handbook/*.synctex.gz
docs/handbook/*.toc
docs/handbook/*.pdf
# and what TeXstudio adds: the SyncTeX file while it is being written, the
# lists of figures and tables, an index, and DVI output
docs/handbook/*.synctex(busy)
docs/handbook/*.lof
docs/handbook/*.lot
docs/handbook/*.idx
docs/handbook/*.ilg
docs/handbook/*.ind
docs/handbook/*.dvi
docs/handbook/*.xdv
docs/handbook/*.bak
docs/handbook/*~

# The folder settings macOS's Finder writes
.DS_Store

# Editor settings, which belong to the person rather than to the project
.vscode/

# Coverage reports
.coverage
coverage.xml
